import sistemaDeMensajeros.*

describe "Pruebas de Mensajería Parte 3" { 
    method initialize() { 
        empresaMensajera.despedirATodos(empresaMensajera.conjuntoDeMensajeros) 
        empresaMensajera.vaciarPendientes() 
        empresaMensajera.reiniciarFacturacion() 
        paquetonViajero.limpiarDestinos() 
    } 
    test "1 Averiguar si un paquete puede ser entregado por al menos un mensajero" { 
        empresaMensajera.contratar(saraConnor) 
        empresaMensajera.contratar(jeanGray) 
        paquete.destino(laMatrix) 
        paquete.pagar() 
        assert.that(empresaMensajera.puedeSerEntregado(paquete)) 
    }
    test "2 Obtener todos los mensajeros que pueden llevar un paquete dado" { 
        empresaMensajera.contratar(jeanGray) 
        empresaMensajera.contratar(saraConnor) 
        neo.tieneCredito(true) 
        empresaMensajera.contratar(neo) 
        paquete.destino(laMatrix) 
        paquete.pagar() 
        const posibles = empresaMensajera.mensajerosQuePuedenLlevar(paquete) 
        assert.equals(2, posibles.size()) 
        assert.that(posibles.contains(jeanGray)) 
        assert.that(posibles.contains(neo)) 
        assert.notThat(posibles.contains(saraConnor)) 
        }
    test "3 Saber si la mensajería tiene sobrepeso" { 
        saraConnor.pesoPropio(70) 
        camion.acoplados(2) 
        empresaMensajera.contratar(saraConnor) 
        assert.that(empresaMensajera.tieneSobrepeso()) }
}
describe "Pruebas de la Empresa de Mensajería" {
    method initialize(){
        empresaMensajera.despedirATodos(empresaMensajera.conjuntoDeMensajeros)
    }
test "1- Contratar a un mensajero" { 
    empresaMensajera.contratar(jeanGray) 
    assert.that(empresaMensajera.conjuntoDeMensajeros.contains(jeanGray)) 
    assert.equals(1, empresaMensajera.conjuntoDeMensajeros.size()) 
    }

test "2 Despedir a un mensajero" { 
    empresaMensajera.contratar(jeanGray) 
    empresaMensajera.contratar(neo) 
    empresaMensajera.despedir(jeanGray) 
    assert.notThat(empresaMensajera.conjuntoDeMensajeros.contains(jeanGray)) 
    assert.equals(1, empresaMensajera.conjuntoDeMensajeros.size()) 
}

test "3 Despedir a todos los mensajeros" { 
    empresaMensajera.contratar(jeanGray) 
    empresaMensajera.contratar(neo) 
    empresaMensajera.despedirATodos(empresaMensajera.conjuntoDeMensajeros) 
    assert.that(empresaMensajera.conjuntoDeMensajeros.isEmpty()) 
    }

test "4 Analizar si la mensajería es grande" { 
    empresaMensajera.contratar(jeanGray) 
    empresaMensajera.contratar(neo)
    empresaMensajera.contratar(saraConnor) 
    assert.that(empresaMensajera.esGrande())   
}

test "5 Paquete entregado por el primer empleado de la mensajería" { 
    empresaMensajera.contratar(jeanGray) 
    empresaMensajera.contratar(saraConnor) 
    paquete.destino(laMatrix) 
    paquete.pagar() 
    assert.that(empresaMensajera.puedeSerEntregadoPorPrimerEmpleado(paquete)) 
}
test "6 Peso del último mensajero de la empresa" { 
    saraConnor.pesoPropio(70) // 70kg
    saraConnor.vehiculo(moto) // 100kg 
    empresaMensajera.contratar(jeanGray) 
    empresaMensajera.contratar(saraConnor) 
    assert.equals(170, empresaMensajera.pesoDeUltimoMensajero()) 
}

}
describe "pruebas de Paquetes de George" {

test "probar que el precio del paquete será 150 si el paquete se 
    envía al puente de Brooklyn " {
    paquete.destino(puenteDeBrooklyn)
    assert.equals(puenteDeBrooklyn.precio(),paquete.precio())
}
test "probar que al inicio el paquete no está  pago ,
pero luego de marcarlo como pago si lo está " {
   assert.notThat(paquete.estaPago())
   paquete.pagar()
   assert.that(paquete.estaPago())
}
test "probar que un paquete no pago no puede ser llevado por 
neo a la matrix" {
    paquete.destino(laMatrix)
    assert.notThat(paquete.puedeSerEntregadoPor(neo))
}

test "probar que un paquete pago puede ser llevado por 
    jeanGrey a la matrix" {
    paquete.destino(laMatrix)
    paquete.pagar()
    assert.that(paquete.puedeSerEntregadoPor(jeanGray))
    assert.that(paquete.estaPago())
}

test "probar que un paquete pago no puede ser llevado por 
    saraConnor con un camion con un acoplado si va al 
    puente de Brooklyn" {
    paquete.destino(puenteDeBrooklyn)
    paquete.pagar()
    camion.acoplados(1)
    assert.notThat (paquete.puedeSerEntregadoPor(saraConnor))
}

test "probar si un paquete pago puede ser llevado por 
    saraConnor con una moto si va al puente de Brooklyn" {
    saraConnor.vehiculo(moto)
    paquete.destino(puenteDeBrooklyn)
    paquete.pagar()
    assert.that (paquete.puedeSerEntregadoPor(saraConnor))
}

}